      <ProjectReference Include="..\..\tests\DotNetDifferentialEvolution.Tests.Common\DotNetDifferentialEvolution.Tests.Common.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="BenchmarkDotNet" Version="0.14.0" />
    </ItemGroup>

</Project>
