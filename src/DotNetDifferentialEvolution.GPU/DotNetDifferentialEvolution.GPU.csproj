<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>DotNetDifferentialEvolution.GPU</RootNamespace>
        <AssemblyName>DotNetDifferentialEvolution.GPU</AssemblyName>
        <PackageId>DotNetDifferentialEvolution.GPU</PackageId>
        <Version>1.1.0</Version>
        <Authors>Eduard Burachek</Authors>
        <Description>Differential Evolution (DE/rand/1/bin) with the whole population on a GPU through ILGPU: CUDA, OpenCL or the CPU accelerator, seeded and reproducible, with a staged builder and an ISolution result.</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/baryon-asymm/DotNetDifferentialEvolution</PackageProjectUrl>
        <RepositoryUrl>https://github.com/baryon-asymm/DotNetDifferentialEvolution</RepositoryUrl>
        <Title>DotNetDifferentialEvolution.GPU</Title>
        <Copyright>Copyright (c) Eduard Burachek, 2024</Copyright>
        <RepositoryType>git</RepositoryType>
        <PackageTags>differential-evolution optimization gpu ilgpu .net</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <!--
      No GeneratePackageOnBuild, for the same reason as the CPU package: a package is packed
      explicitly from a tagged commit (gpu-v*, release.yml), never as a side effect of a local
      build. SourceLink as in the CPU package: the PDB embedded, sources resolved from GitHub at
      the packed commit. No package validation: 1.0.0 replaces every public type of 0.x.
    -->
    <PropertyGroup>
        <DebugType>embedded</DebugType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
      <!-- Exactly 1.5.3: the libdevice post-link reads ILGPU internals and asserts this version
           (Devices/LibDevice/BOOT.md). No ILGPU.Algorithms: CUDA math comes from libdevice. -->
      <PackageReference Include="ILGPU" Version="[1.5.3]" />
      <!-- ISolution, the result contract shared with the CPU package (BOOT.md, v1 decisions). -->
      <PackageReference Include="DotNetOptimization.Abstractions" Version="1.0.0" />
    </ItemGroup>

    <ItemGroup>
        <!-- The DE step, the draw source and the transfer counter are internal; the tests drive
             them directly (ACCEPTANCE.md, checks 1b-1g, 2b, 3a-3c, 5b). -->
        <InternalsVisibleTo Include="DotNetDifferentialEvolution.GPU.Test" />
        <!-- ILGPU emits its kernel launchers into a dynamic assembly named ILGPURuntime, which must
             see every type a kernel touches; the kernel structs here are internal. -->
        <InternalsVisibleTo Include="ILGPURuntime" />
    </ItemGroup>

    <ItemGroup>
        <None Include="../../LICENSE" Pack="true" PackagePath="\" />
        <None Include="ILGPU_LICENSE" Pack="true" PackagePath="\" />
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
