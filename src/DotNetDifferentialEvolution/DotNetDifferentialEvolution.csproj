<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <Title>DotNetDifferentialEvolution</Title>
        <Authors>Eduard Burachek</Authors>
        <Description>A .NET library for Differential Evolution optimization with multi-processing and SIMD acceleration.</Description>
        <Copyright>Copyright (c) Eduard Burachek, 2025</Copyright>
        <PackageProjectUrl>https://github.com/baryon-asymm/DotNetDifferentialEvolution</PackageProjectUrl>
        <RepositoryUrl>https://github.com/baryon-asymm/DotNetDifferentialEvolution</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>differential-evolution de optimization .net</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Version>3.0.0</Version>
    </PropertyGroup>

    <!--
      Consumer experience: ship the XML doc (IntelliSense) and wire up SourceLink so debuggers
      can step into the library's sources straight from GitHub at the exact commit.
      SourceLink is built into the .NET 8+ SDK, so no package reference is needed.
    -->
    <PropertyGroup>
        <!-- Pack the XML documentation file so consumers get IntelliSense tooltips. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <!-- SourceLink: embed the PDB into the DLL (no separate symbol package to publish) and
             record the GitHub repository + commit so sources resolve on demand while debugging. -->
        <DebugType>embedded</DebugType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>

        <!-- Normalize source paths for a deterministic, SourceLink-friendly build on CI. -->
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <None Include="../../LICENSE" Pack="true" PackagePath="\" />
        <None Include="../../README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <!-- Expose internal helpers (MutationMath, CrossoverHelper, RandomIndexSelector) to the
         unit-test assembly so they can be tested in isolation. Test-only; no behavior change. -->
    <ItemGroup>
        <InternalsVisibleTo Include="DotNetDifferentialEvolution.UnitTests" />
    </ItemGroup>

</Project>
