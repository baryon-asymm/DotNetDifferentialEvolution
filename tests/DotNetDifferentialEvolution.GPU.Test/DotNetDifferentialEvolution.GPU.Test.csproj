<Project Sdk="Microsoft.NET.Sdk">

    <!-- Common settings (TFM, nullable, RollForward, …) come from tests/Directory.Build.props. -->
    <PropertyGroup>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" Version="6.0.0"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0"/>
        <PackageReference Include="xunit" Version="2.5.3"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
        <!-- tests/Directory.Build.props imports the shared abstractions for the CPU test projects.
             The GPU package does not depend on them (yet), so the namespace does not exist here. -->
        <Using Remove="DotNetOptimization.Abstractions"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\DotNetDifferentialEvolution.GPU\DotNetDifferentialEvolution.GPU.csproj"/>
    </ItemGroup>

</Project>
