<Project Sdk="Microsoft.NET.Sdk">

    <!-- Common settings (TFM, nullable, RollForward, …) come from tests/Directory.Build.props. -->
    <PropertyGroup>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" Version="6.0.0"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1"/>
        <PackageReference Include="xunit" Version="2.9.3"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
    </ItemGroup>

    <ItemGroup>
        <!-- ILGPU emits its kernel launchers into a dynamic assembly named ILGPURuntime, which must
             see the tests' objective structs; they are internal (CA1515). -->
        <InternalsVisibleTo Include="ILGPURuntime" />
    </ItemGroup>

    <ItemGroup>
        <!-- The PTX texts of check L2, read from the output directory (Devices/BOOT.md, their provenance). -->
        <None Include="Devices\Ptx\*.ptx" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\DotNetDifferentialEvolution.GPU\DotNetDifferentialEvolution.GPU.csproj"/>
        <!-- The CPU package, for the parity check of the DE step (GPU ACCEPTANCE.md, check 1g):
             the test project references both packages, neither package the other. -->
        <ProjectReference Include="..\..\src\DotNetDifferentialEvolution\DotNetDifferentialEvolution.csproj"/>
    </ItemGroup>

</Project>
