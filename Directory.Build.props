<Project>

    <!--
      Repo-wide build strictness at its maximum (owner's decision, 2026-10-03; root BOOT.md,
      Invariants): the full set of .NET analyzers and code-style checks, and fail the build on ANY
      warning. Applies to every project (src, benchmarks, tests);
      the Tests props import this file so the test projects inherit the same rules.
    -->
    <PropertyGroup>
        <!-- Treat every compiler/analyzer warning as an error → the build crashes on warnings. -->
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>

        <!-- Maximum static analysis: all .NET analyzer rules at the latest level, plus
             IDE/code-style rules enforced during build. -->
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <AnalysisLevel>latest-all</AnalysisLevel>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

        <!-- Surface every warning rather than capping the count; every warning wave, present and
             future. -->
        <WarningLevel>9999</WarningLevel>

        <!-- The compiler's own extra strictness checks. -->
        <Features>strict</Features>

        <!-- XML documentation for every project: CS1591 then holds for every publicly visible
             member (test methods included), and IDE0005 (unnecessary usings) is only reported in a
             build that generates the documentation file. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <!-- No warning is exempt from being an error, the NuGet vulnerability audit (NU1901-NU1904)
             included: an advisory published against a dependency fails the build until it is dealt
             with (owner's decision, 2026-10-03: the maximum, with no exceptions). The SDK's default
             NoWarn is cleared in Directory.Build.targets. -->

        <!-- Pin the language version instead of letting it be inferred from the target framework.
             Inferred, it would move on its own the day the TFM moves, and it diverged between the
             library (12.0, from net8.0) and the test projects (latest), so test code could use
             syntax the shipping code could not compile. -->
        <LangVersion>12.0</LangVersion>
    </PropertyGroup>

</Project>
